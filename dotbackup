#!/bin/bash

set -eu -o pipefail

# Resolve symlinks so the repo is found when run via e.g. ~/bin/dotbackup
: "${DOTBACKUP_DIR:=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}"
DOTBACKUP_SCRIPT="$DOTBACKUP_DIR/dotbackup.py"
VENV_DIR="$DOTBACKUP_DIR/myenv"

if [ ! -d "$DOTBACKUP_DIR" ];then
    echo Cannot find dotbackup directory \"$DOTBACKUP_DIR\"
    exit 1
fi

if [ ! -f "$DOTBACKUP_SCRIPT" ];then
    echo Cannot find dotbackup script \"$DOTBACKUP_SCRIPT\"
    exit 1
fi

# Check for pip rather than the directory, so a venv left half-created
# by a failed run is rebuilt
if [ ! -x "$VENV_DIR/bin/pip" ]; then
    python3 -m venv --clear "$VENV_DIR"
    "$VENV_DIR/bin/pip" install -r "$DOTBACKUP_DIR/requirements.txt"
fi

"$VENV_DIR/bin/python3" "$DOTBACKUP_SCRIPT" "$@"
